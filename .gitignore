# Local .terraform directories
**/.terraform/*

# Terraform state files (never commit these — remote state lives in S3)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files that may contain sensitive data
# (this project's dev.tfvars/prod.tfvars have no secrets, but this is the
# safe default — uncomment the two lines below if you add sensitive values)
# *.tfvars
# *.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file — commit this normally, listed here only as a reminder it's provider-specific
# .terraform.lock.hcl

# OS/editor cruft
.DS_Store
*.swp
.vscode/
